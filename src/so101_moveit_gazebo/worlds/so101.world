<?xml version="1.0"?>
<sdf version="1.6">
  <world name="so101_world">
    <!-- 提供 /gazebo/model_states 和 /gazebo/link_states 话题（夹取验证需要读物体位姿） -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
  </world>
</sdf>
