<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- SO101 手臂 5 个关节的 ros2_control 硬件描述 -->
  <xacro:macro name="so101_ros2_control" params="name ros2_control_hardware_type">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${ros2_control_hardware_type == 'mock_components'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${ros2_control_hardware_type == 'gazebo'}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
      </hardware>
      <joint name="shoulder_pan">
        <command_interface name="position">
          <!-- gazebo_ros2_control 的默认 PID 增益太弱，扛不住重力，机械臂会持续下沉漂移；
               这里给位置接口显式指定增益（mock_components 会忽略这些参数） -->
          <param name="p">25</param>
          <param name="i">0.5</param>
          <param name="d">5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="shoulder_lift">
        <command_interface name="position">
          <!-- gazebo_ros2_control 的默认 PID 增益太弱，扛不住重力，机械臂会持续下沉漂移；
               这里给位置接口显式指定增益（mock_components 会忽略这些参数） -->
          <param name="p">25</param>
          <param name="i">0.5</param>
          <param name="d">5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="elbow_flex">
        <command_interface name="position">
          <!-- gazebo_ros2_control 的默认 PID 增益太弱，扛不住重力，机械臂会持续下沉漂移；
               这里给位置接口显式指定增益（mock_components 会忽略这些参数） -->
          <param name="p">25</param>
          <param name="i">0.5</param>
          <param name="d">5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="wrist_flex">
        <command_interface name="position">
          <!-- gazebo_ros2_control 的默认 PID 增益太弱，扛不住重力，机械臂会持续下沉漂移；
               这里给位置接口显式指定增益（mock_components 会忽略这些参数） -->
          <param name="p">25</param>
          <param name="i">0.5</param>
          <param name="d">5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="wrist_roll">
        <command_interface name="position">
          <!-- gazebo_ros2_control 的默认 PID 增益太弱，扛不住重力，机械臂会持续下沉漂移；
               这里给位置接口显式指定增益（mock_components 会忽略这些参数） -->
          <param name="p">25</param>
          <param name="i">0.5</param>
          <param name="d">5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
